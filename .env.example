# Copy to .env and fill in. Real environment variables take precedence.
GEMINI_API_KEY=your_api_key_here
# Comma-separated origins allowed to call the API (the Angular app).
FIDELA_CORS_ORIGINS=http://localhost:4200
# Set to 0 in any shared or production environment.
FIDELA_SEED_DEMO_USERS=1
# Optional: fixed signing key (otherwise one is generated in data/secret.key).
# FIDELA_SECRET_KEY=

# Email (Brevo). Without BREVO_API_KEY, emails are printed to the API console.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support@fidelatranslations.ca
BREVO_SENDER_NAME=Fidela Translations
# Public address of the Angular app, used in email links.
FIDELA_PUBLIC_URL=http://localhost:4200
# Who gets "new order" alerts (comma-separated).
FIDELA_STAFF_EMAILS=
# Development safety net: every email goes here instead of the real recipient. Remove in production.
FIDELA_MAIL_REDIRECT=
